# Alert relay only. Keep this file separate from the business .env.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TYPE=auto
ALERT_WEBHOOK_SECRET=
ALERT_WEBHOOK_ENV=prod
ALERT_WEBHOOK_KEYWORD=告警
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_TLS=true
SMTP_SECURE=false
REDIS_PASSWORD=
ALERT_RELAY_STATE_FILE=/data/alert-relay-state.json
ALERT_RELAY_DEFAULT_CHANNELS=webhook
ALERT_RELAY_WARNING_CHANNELS=webhook,email
ALERT_RELAY_CRITICAL_CHANNELS=webhook,email
