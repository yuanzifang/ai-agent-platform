      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(http_server_requests_seconds_count{job=\"ai-agent-backend-pods\",pod=~\"$pod\",uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "{{pod}} qps",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "API P95 by Pod",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,pod) (rate(http_server_requests_seconds_bucket{job=\"ai-agent-backend-pods\",pod=~\"$pod\",uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "{{pod}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP 5xx by Pod",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(http_server_requests_seconds_count{job=\"ai-agent-backend-pods\",pod=~\"$pod\",status=~\"5..\",uri!~\"/actuator.*\"}[5m]))",
