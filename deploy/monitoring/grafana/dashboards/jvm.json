{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "pod",
        "label": "Backend / Gateway Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(jvm_memory_used_bytes{job=\"ai-agent-backend-pods\"}, pod)",
        "query": {
          "query": "label_values(jvm_memory_used_bytes{job=\"ai-agent-backend-pods\"}, pod)",
          "refId": "StandardVariableQuery"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "JVM Heap Used",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (pod,id) (jvm_memory_used_bytes{job=\"ai-agent-backend-pods\",pod=~\"$pod\",area=\"heap\"})",
          "legendFormat": "{{pod}} / {{id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Process CPU and Threads",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "process_cpu_usage{job=\"ai-agent-backend-pods\",pod=~\"$pod\"}",
          "legendFormat": "{{pod}} cpu",
          "refId": "A"
        },
        {
          "expr": "jvm_threads_live_threads{job=\"ai-agent-backend-pods\",pod=~\"$pod\"}",
          "legendFormat": "{{pod}} threads",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM GC Pause Rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{job=\"ai-agent-backend-pods\",pod=~\"$pod\"}[5m])",
          "legendFormat": "{{pod}} / {{action}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
