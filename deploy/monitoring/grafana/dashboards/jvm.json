      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (pod) (increase(jvm_gc_pause_seconds_count{job=\"ai-agent-backend-pods\",pod=~\"$pod\",action=~\".*minor.*|.*young.*\"}[5m]))",
