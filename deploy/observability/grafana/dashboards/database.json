{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "MySQL Up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "max(mysql_up)", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "type": "stat",
      "title": "Redis Up",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "max(redis_up)", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "type": "stat",
      "title": "PostgreSQL Up",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "max(pg_up)", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "type": "stat",
      "title": "Redis 内存",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "max(redis_memory_used_bytes)", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "timeseries",
      "title": "MySQL 连接数",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "mysql_global_status_threads_connected", "legendFormat": "connected", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "mysql_global_variables_max_connections", "legendFormat": "max", "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "type": "timeseries",
      "title": "Redis 内存与客户端",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "redis_memory_used_bytes", "legendFormat": "memory", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "redis_connected_clients", "legendFormat": "clients", "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "type": "timeseries",
      "title": "PostgreSQL 连接与数据库大小",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "pg_stat_activity_count", "legendFormat": "connections", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "pg_settings_max_connections", "legendFormat": "max", "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "pg_database_size_bytes", "legendFormat": "db {{datname}}", "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    }
  ],
  "schemaVersion": 39,
  "title": "AI Agent Platform - Database",
  "uid": "aap-database",
  "version": 1
}
