{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Backend Up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "up{job=\"ai-agent-backend\"}", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "type": "stat",
      "title": "HTTP 请求速率 (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count[5m]))", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "HTTP 5xx 速率 (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "JVM 堆使用",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "timeseries",
      "title": "HTTP 请求速率",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count[5m])) by (uri)", "refId": "A", "legendFormat": "{{uri}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP P95 延迟",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "JVM 内存",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes) by (area, id)", "refId": "A", "legendFormat": "{{area}} {{id}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "timeseries",
      "title": "进程 CPU",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "process_cpu_usage", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "ES outbox 待处理",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 20 },
      "targets": [
        { "expr": "knowledge_search_outbox_pending", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "type": "stat",
      "title": "ES outbox 失败",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 20 },
      "targets": [
        { "expr": "knowledge_search_outbox_failed", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "ES outbox 执行中",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 20 },
      "targets": [
        { "expr": "knowledge_search_outbox_locked", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "type": "stat",
      "title": "ES outbox 最老等待",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 20 },
      "targets": [
        { "expr": "knowledge_search_outbox_oldest_pending_seconds", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "type": "timeseries",
      "title": "ES outbox 趋势",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "knowledge_search_outbox_pending", "legendFormat": "pending", "refId": "A" },
        { "expr": "knowledge_search_outbox_failed", "legendFormat": "failed", "refId": "B" },
        { "expr": "knowledge_search_outbox_locked", "legendFormat": "locked", "refId": "C" }
      ]
    },
    {
      "type": "stat",
      "title": "Prometheus 触发中告警",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "sum(ALERTS{alertstate=\"firing\"})", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["ai-agent-platform"],
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "AI Agent Platform Overview",
  "uid": "ai-agent-overview",
  "version": 1
}
