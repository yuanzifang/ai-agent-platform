# Docker Compose 环境变量模板
# 复制为 .env.docker 后填写；scripts/docker-up.sh 会自动生成强随机密码。
# 切勿提交 .env.docker 到 Git（已加入 .gitignore）。

# ---- 模型 ----
# 云端可改用 OpenAI 兼容 embedding API，无需 Ollama；endpoint 可带 /v1
EMBEDDING_PROVIDER=ollama
EMBEDDING_ENDPOINT=http://ollama:11434
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USER=aiagent
MYSQL_PASSWORD=change-me

# ---- Redis ----
REDIS_PASSWORD=change-me

# ---- PgVector ----
PG_USERNAME=aiagent
PG_PASSWORD=change-me

# ---- MinIO（控制台强密码）----
# 官方 minio/minio 镜像自 2025 起停止匿名分发；可用自建镜像仓库覆盖 MINIO_IMAGE，
# 或改用 docker-compose.external-minio.yml 连接宿主机 MinIO。
MINIO_IMAGE=minio/minio:latest
MINIO_ROOT_USER=aiagent
MINIO_ROOT_PASSWORD=change-me
MINIO_CONSOLE_PORT=9001
# 仅 external-minio override 使用
MINIO_EXTERNAL_ENDPOINT=http://host.docker.internal:9000

# ---- 应用密钥（脚本自动生成）----
JWT_SECRET=change-me
AES_KEY=change-me
PLATFORM_ADMIN_PASSWORD=change-me

# ---- 网络 / 安全 ----
HTTP_PORT=80
# 生产建议 false；API/MCP 工具将禁止访问内网地址
TOOL_ALLOW_PRIVATE=false
# 允许访问的内网/私有域名（逗号分隔）；allow-private=false 时生效
TOOL_ALLOWED_HOSTS=
RATE_LIMIT_PER_MINUTE=60
# 数据库连接池；100 并发压测显示需结合 DB/上游 profiling，不盲目放大
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=10
DB_POOL_CONNECTION_TIMEOUT_MS=5000
PGVECTOR_POOL_SIZE=8
EMBEDDING_QUERY_CACHE_TTL_SECONDS=300
EMBEDDING_QUERY_CACHE_MAX_ENTRIES=2000
# 工具入参校验失败后允许模型修正的最大次数（含首次）
TOOL_INPUT_VALIDATION_MAX_ATTEMPTS=3
# 压测定位用；默认关闭
REQUEST_TIMING_ENABLED=false
REQUEST_TIMING_SLOW_MS=1000
# Prompt 注入启发式检测；组合特征/安全绕过达到 block-score 时 BLOCK
MODERATION_PROMPT_INJECTION_ENABLED=true
MODERATION_PROMPT_INJECTION_BLOCK_SCORE=2
SKILL_SCRIPT_ENABLED=true

# ---- 备份（scripts/backup.sh）----
# 异地 MinIO/S3 兼容端点；配置后启用加密上传
BACKUP_OFFSITE_ENDPOINT=
BACKUP_OFFSITE_BUCKET=
BACKUP_OFFSITE_ACCESS_KEY=
BACKUP_OFFSITE_SECRET_KEY=
BACKUP_OFFSITE_PREFIX=ai-agent-platform
# 异地 bucket 版本化/对象锁（锁定时长 0=关闭；锁定 bucket 必须用 --with-lock 创建）
BACKUP_OFFSITE_VERSIONING=1
BACKUP_OFFSITE_LOCK_DAYS=30
# 必填：openssl 加密密钥文件（勿提交仓库/勿与备份同机保存）
BACKUP_ENCRYPT_KEY_FILE=
# 备份时额外归档 MySQL binlog（需要 REPLICATION CLIENT/SLAVE）
BACKUP_BINLOG_ARCHIVE=0
# 连续 binlog 运输（scripts/binlog-ship.sh）
BINLOG_ARCHIVE_DIR=
BINLOG_SHIP_RETENTION_DAYS=7
BINLOG_SHIP_OFFSITE_ENDPOINT=
BINLOG_SHIP_OFFSITE_BUCKET=
BINLOG_SHIP_OFFSITE_ACCESS_KEY=
BINLOG_SHIP_OFFSITE_SECRET_KEY=
BINLOG_SHIP_OFFSITE_PREFIX=ai-agent-platform/binlog
BINLOG_SHIP_ENCRYPT_KEY_FILE=

# ---- 可观测性 ----
# 群机器人告警（钉钉/企微/飞书；钉钉 secret 会按官方 query 加签）
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
# 入站 /internal/alertmanager 共享 token；留空表示兼容旧行为，生产建议设置
ALERT_WEBHOOK_INTERNAL_TOKEN=
# /actuator/prometheus 抓取 token；留空=旧行为，生产建议设置并同步 Prometheus
METRICS_SCRAPE_TOKEN=
ALERT_WEBHOOK_ENV=prod
ALERTMANAGER_BIND=127.0.0.1
ALERTMANAGER_PORT=9093
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me

# ---- 可选：ASR / SMTP ----
# 默认关闭；接入本地/远程 OpenAI 兼容 ASR 时设为 true 并填写 endpoint
ASR_ENABLED=false
ASR_ENDPOINT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_TLS=true

# ---- 构建 ----
# 国内网络可选：https://maven.aliyun.com/repository/public
MAVEN_MIRROR_URL=

# ---- JVM ----
JAVA_OPTS=-Xms512m -Xmx2g

# ---- 可选：检索后端切换 ----
# 默认 mysql + pgvector；修改前先确认网络、索引和备份
KEYWORD_SEARCH_PROVIDER=mysql
# ES：启用适配器后，知识库详情页可选择该后端
SEARCH_ES_ENABLED=false
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=aap_knowledge_chunks_v1
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
# Qdrant：启用适配器后，知识库详情页可选择该后端
VECTOR_STORE=pgvector
VECTOR_QDRANT_ENABLED=false
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=aap
