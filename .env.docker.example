# Docker Compose 环境变量模板
# 复制为 .env.docker 后填写；scripts/docker-up.sh 会自动生成强随机密码。
# 切勿提交 .env.docker 到 Git（已加入 .gitignore）。

# ---- 模型 ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USER=aiagent
MYSQL_PASSWORD=change-me

# ---- Redis ----
REDIS_PASSWORD=change-me

# ---- PgVector ----
PG_USERNAME=aiagent
PG_PASSWORD=change-me

# ---- MinIO（控制台强密码）----
MINIO_ROOT_USER=aiagent
MINIO_ROOT_PASSWORD=change-me
MINIO_CONSOLE_PORT=9001

# ---- 应用密钥（脚本自动生成）----
JWT_SECRET=change-me
AES_KEY=change-me
PLATFORM_ADMIN_PASSWORD=change-me

# ---- 网络 / 安全 ----
HTTP_PORT=80
# 生产建议 false；API/MCP 工具将禁止访问内网地址
TOOL_ALLOW_PRIVATE=false
# 允许访问的内网/私有域名（逗号分隔）；allow-private=false 时生效
TOOL_ALLOWED_HOSTS=
RATE_LIMIT_PER_MINUTE=60
SKILL_SCRIPT_ENABLED=true

# ---- 可观测性 ----
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me

# ---- 可选：ASR / SMTP ----
# 默认关闭；接入本地/远程 OpenAI 兼容 ASR 时设为 true 并填写 endpoint
ASR_ENABLED=false
ASR_ENDPOINT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_TLS=true

# ---- JVM ----
JAVA_OPTS=-Xms512m -Xmx2g
